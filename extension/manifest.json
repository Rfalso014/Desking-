{
  "manifest_version": 3,
  "name": "Gestor de Descargas",
  "version": "1.0.0",
  "description": "Botón de descarga sobre los videos y menú contextual: envía el contenido a la aplicación Gestor de Descargas.",
  "minimum_chrome_version": "116",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "storage",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Gestor de Descargas",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "key": "",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
